{
  "description": "Bounded Square inbox checks at supported Claude Code turn boundaries",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "square claude-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "square claude-hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
