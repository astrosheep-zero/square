{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "square codex-hook", "timeout": 5 }] }
    ],
    "SessionResume": [
      { "hooks": [{ "type": "command", "command": "square codex-hook", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "square codex-hook", "timeout": 5 }] }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "square codex-hook",
            "timeout": 5,
            "statusMessage": "square-codex-hook",
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
