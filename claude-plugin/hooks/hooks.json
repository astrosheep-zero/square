{
  "description": "Bounded Square inbox admission between Claude Code agent steps",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "square claude-hook", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "square claude-hook", "timeout": 5 }] }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "square claude-hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
