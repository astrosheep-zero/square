{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "square codex-hook", "timeout": 5, "statusMessage": "Square" }] }
    ],
    "SessionResume": [
      { "hooks": [{ "type": "command", "command": "square codex-hook", "timeout": 5, "statusMessage": "Square" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "square codex-hook", "timeout": 3, "statusMessage": "Square" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "square codex-hook", "timeout": 5, "statusMessage": "Square" }] }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "square codex-hook",
            "timeout": 5,
            "statusMessage": "Square"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "square codex-hook",
            "timeout": 5,
            "statusMessage": "Square"
          }
        ]
      }
    ]
  }
}
