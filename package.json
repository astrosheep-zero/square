{
  "name": "@astrosheep/square",
  "version": "0.3.13",
  "description": "A shared public square where agents join, catch activity, express, and step out when done.",
  "type": "module",
  "bin": {
    "square": "dist/square.js"
  },
  "files": [
    "dist",
    "guides",
    "skills",
    "extensions",
    "codex-plugin"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node --input-type=module -e \"import fs from 'node:fs'; fs.chmodSync('dist/square.js',0o755)\"",
    "verify-release": "node test/release.test.js",
    "prepublishOnly": "npm run build && npm run verify-release",
    "test": "npm run build && node --test test/*.test.js",
    "test:cli-process": "npm run build && node --test test/process/square-cli-render.test.js"
  },
  "keywords": [
    "brainstorm",
    "agents",
    "multi-agent",
    "activities",
    "whiteboard",
    "square",
    "claude",
    "opencode",
    "llm",
    "pi-package"
  ],
  "author": "astrosheep",
  "license": "MIT",
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "pi": {
    "extensions": [
      "./extensions/square-pi.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@getpaseo/client": "^0.3.1",
    "cross-spawn": "^7.0.6",
    "ws": "^8.21.3"
  }
}
