{
  "name": "@astrosheep/agent-delivery",
  "version": "0.1.0",
  "description": "Existing-only native text delivery to OpenCode, Claude and Pi sessions, independent of Square.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": "^22.16.0 || >=24.0.0" },
  "files": ["dist", "README.md", "VALIDATION.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
