{
  "name": "@astrosheep/agent-delivery",
  "version": "0.1.1",
  "description": "Text delivery to Codex, OpenCode, Claude, Pi and Paseo agents, independent of Square.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": "^22.16.0 || >=24.0.0" },
  "files": ["dist", "README.md", "VALIDATION.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./pi-receiver": { "types": "./dist/pi.d.ts", "import": "./dist/pi.js" },
    "./codex-hook": { "types": "./dist/codex-hook.d.ts", "import": "./dist/codex-hook.js" }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --import ./test/sandbox-env.js --test test/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": { "@getpaseo/client": "0.11.2", "@opencode/client": "2.0.20", "ws": "8.22.0" },
  "devDependencies": { "@types/node": "^22.16.0", "@types/ws": "^8.18.1", "typescript": "^5.8.0" }
}
