{
  "name": "@astrosheep/square-slack-bridge",
  "version": "0.1.0",
  "description": "Mirror one Slack channel and one local square in both directions.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": "^22.16.0 || >=24.0.0" },
  "bin": { "square-slack-bridge": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
